# Use small values first, then increase to DATASET_SIZE=5000 and EVAL_SIZE=100.
DATASET_NAME=forag/webglm_oe
DATASET_SIZE=5000
EVAL_SIZE=100
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_N=10
FINAL_TOP_K=5
MMR_LAMBDA=0.7
PARSE_NUMBERED_DOCS=false
SEED=42
# Providers: openai or groq. Groq models include llama-3.3-70b-versatile.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0
MAX_TOKENS=1200
OPENAI_API_KEY=
GROQ_API_KEY=

